# Puerto donde escucha el MCP server
MCP_HOST=0.0.0.0
MCP_PORT=8765

# Token Bearer para autenticar a n8n contra el MCP.
# Generar uno largo (ej: openssl rand -hex 32) y configurarlo igual en n8n.
MCP_AUTH_TOKEN=cambiar-este-token-por-uno-largo-y-aleatorio

# URL pública base desde donde se sirven los PDFs de presupuesto (sin barra
# final). Los PDFs van en data/presupuestos/ y el server los sirve en
# /presupuestos. Si la seteás, presupuesto_pdf devuelve la URL completa.
# Ej: https://tu-dominio.com/presupuestos
PRESUPUESTOS_BASE_URL=

# Token para acceder al panel web de mensajes (/panel y /api/mensajes).
# Si lo dejás vacío, el panel queda PÚBLICO. Acceso: https://tu-dominio.com/panel?token=...
PANEL_TOKEN=

# Datos de la empresa
EMPRESA_NOMBRE=Consultoría Digital
EMPRESA_CUIT=
EMPRESA_EMAIL=hola@consultoriadigital.com.ar
EMPRESA_TELEFONO=
EMPRESA_WEB=https://consultoriadigital.com.ar
