# Puerto donde escucha el MCP server
MCP_HOST=0.0.0.0
MCP_PORT=8765

# Token Bearer para autenticar a n8n contra el MCP.
# Generar uno largo (ej: openssl rand -hex 32) y configurarlo igual en n8n.
MCP_AUTH_TOKEN=cambiar-este-token-por-uno-largo-y-aleatorio

# Datos de la empresa que aparecen en los PDFs de presupuesto
EMPRESA_NOMBRE=Consultoría Digital
EMPRESA_CUIT=
EMPRESA_EMAIL=hola@consultoriadigital.com.ar
EMPRESA_TELEFONO=
EMPRESA_WEB=https://consultoriadigital.com.ar

# URL pública desde donde se sirven los PDFs (para enviar el link por WhatsApp).
# Si servís los PDFs por Nginx, apuntá acá al path público.
PRESUPUESTOS_BASE_URL=https://tu-dominio.com/presupuestos

# Validez por defecto (días) de un presupuesto
PRESUPUESTO_VALIDEZ_DIAS=15

# -----------------------------------------------------------------------------
# Kommo CRM
# -----------------------------------------------------------------------------
# Subdominio de tu cuenta de Kommo. Si tu URL es https://miempresa.kommo.com,
# acá va: miempresa
KOMMO_SUBDOMAIN=

# Long-lived access token. Se genera en Kommo:
#   Configuración → Integraciones → Crear integración (privada) → Access Token
# Pegar el token sin el prefijo "Bearer ".
KOMMO_ACCESS_TOKEN=

# IDs por defecto (opcionales). Si los completás, los podés usar como fallback
# desde los tools sin tener que pasarlos en cada llamada.
KOMMO_PIPELINE_ID=
KOMMO_STATUS_INICIAL_ID=
KOMMO_STATUS_MEDIA_ID=
KOMMO_STATUS_ALTA_ID=
KOMMO_STATUS_DESCARTADO_ID=
KOMMO_RESPONSABLE_DEFAULT_ID=
