# Reverse proxy del MCP server.
# Reemplazar tu-dominio.com y rutas según el VPS.

server {
    listen 80;
    server_name tu-dominio.com;
    # Recomendado: redirigir a HTTPS y obtener cert con certbot.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name tu-dominio.com;

    ssl_certificate     /etc/letsencrypt/live/tu-dominio.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tu-dominio.com/privkey.pem;

    # Endpoint del MCP server (consumido por n8n)
    location /mcp/ {
        proxy_pass         http://127.0.0.1:8765/mcp/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # streamable-http / SSE: deshabilitar buffering y permitir conexiones largas
        proxy_buffering    off;
        proxy_cache        off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
